# Copy to .env and fill in what you need. Everything is optional; the demo works with none of it.

# Genres, similar artists and recommendations for real uploads (free: https://www.last.fm/api/account/create)
LASTFM_API_KEY=

# "Connect Spotify" quick setup (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must match a redirect URI registered in the Spotify dashboard
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/spotify/callback
# 1 = "Connect Spotify" uses built-in sample data instead of a real login
SPOTIFY_FAKE=

# Optional local LLM. From inside Docker, reach Ollama on your machine with host.docker.internal
# OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=

# Use Postgres instead of SQLite (with `docker compose --profile postgres up`)
# DATABASE_URL=postgresql+psycopg://liner:liner@db:5432/linernotes
